# Copy this file to ".env" and fill in real values. Never commit ".env".
# When adding variables, also update the schema in "src/env.js".

# Drizzle / SQLite
DATABASE_URL="file:./db.sqlite"

# Shared secret the pharmacy uses to sign webhook calls (min 16 chars).
# Generate one with: openssl rand -hex 32
PHARMACY_WEBHOOK_SECRET="replace-with-a-long-random-string"
